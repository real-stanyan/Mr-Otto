{
  "name": "mr-otto",
  "version": "1.0.8",
  "productName": "Mr Otto",
  "description": "Mr Otto — macOS desktop GUI agent",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p services/edge",
    "pretest": "node scripts/fix-pty-perms.mjs",
    "test": "npm run typecheck && vitest run",
    "e2e": "electron-vite build && playwright test",
    "dev": "node scripts/build-island.mjs --debug && node scripts/build-siminput.mjs --debug && electron-vite dev",
    "dev:sync": "node scripts/sync-dev-data.mjs",
    "build": "electron-vite build",
    "postinstall": "node scripts/fix-pty-perms.mjs",
    "rebuild-native": "electron-rebuild -f -w better-sqlite3 -w node-pty",
    "dist:mac": "node scripts/build-island.mjs && node scripts/build-siminput.mjs && electron-vite build && electron-builder --mac --arm64",
    "dist:win": "node scripts/ensure-win-bindings.mjs && electron-vite build && electron-builder --win --x64 --config.npmRebuild=false",
    "release": "node scripts/release.mjs"
  },
  "main": "out/main/index.js",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "private": "true",
  "type": "module",
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260826.1",
    "@electron/rebuild": "^4.2.0",
    "@noble/ciphers": "^2.3.0",
    "@noble/curves": "^2.3.0",
    "@noble/hashes": "^2.3.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.0.1",
    "material-icon-theme": "^5.37.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.15",
    "@assistant-ui/react-markdown": "^0.14.11",
    "@assistant-ui/react-streamdown": "^0.3.10",
    "@firecrawl/anydoc": "0.2.3",
    "@lobehub/icons": "^5.16.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@supabase/supabase-js": "^2.112.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "gsap": "^3.15.0",
    "heat-graph": "^0.0.15",
    "highlight.js": "^11.12.0",
    "katex": "^0.16.47",
    "lucide-react": "^1.31.0",
    "node-pty": "^1.1.0",
    "qrcode-generator": "^2.0.4",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^3.0.6",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "thinking-orbs": "^0.3.1",
    "vaul": "^1.1.2",
    "zustand": "^5.0.15"
  }
}
