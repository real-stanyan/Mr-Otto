      "css": ".ds-seg { display: flex; width: 234px; height: 36px; padding: 3px; border-radius: 8px; background: var(--muted, #e5e1d3); } .ds-seg-tab { flex: 1; border: 1px solid transparent; border-radius: 6px; background: transparent; color: color-mix(in srgb, var(--foreground, #000000) 60%, transparent); font: 500 14px/1 -apple-system, \"PingFang SC\", sans-serif; cursor: pointer; transition: color 150ms cubic-bezier(0.23, 1, 0.32, 1), background-color 150ms cubic-bezier(0.23, 1, 0.32, 1); } .ds-seg-tab:hover { color: var(--foreground, #000000); } .ds-seg-tab[aria-selected=\"true\"] { background: var(--background, #efece3); color: var(--foreground, #000000); box-shadow: 0 1px 2px rgb(0 0 0 / 0.08); } .ds-seg-tab:focus-visible { outline: none; box-shadow: 0 0 0 3px color-mix(in srgb, var(--ring, #4a70a9) 50%, transparent); }"
    }
