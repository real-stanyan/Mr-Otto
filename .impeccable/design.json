      "css": ".ds-btn-primary { background: var(--primary, #4a70a9); color: var(--primary-foreground, #ffffff); height: 36px; padding: 0 16px; border: none; border-radius: 6px; font: 500 14px/1 -apple-system, \"PingFang SC\", sans-serif; cursor: pointer; transition: background-color 150ms cubic-bezier(0.23, 1, 0.32, 1), transform 150ms cubic-bezier(0.23, 1, 0.32, 1), box-shadow 150ms cubic-bezier(0.23, 1, 0.32, 1); } .ds-btn-primary:hover { background: color-mix(in srgb, var(--primary, #4a70a9) 90%, transparent); } .ds-btn-primary:active { transform: scale(0.97); } .ds-btn-primary:focus-visible { outline: none; box-shadow: 0 0 0 3px color-mix(in srgb, var(--ring, #4a70a9) 50%, transparent); }"
    },
    {
