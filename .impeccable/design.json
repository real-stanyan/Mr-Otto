      "html": "<div class=\"ds-inset\"><div class=\"ds-inset-label\">连接器</div><div class=\"ds-inset-group\"><div class=\"ds-inset-row\">Shopify</div><div class=\"ds-inset-row\">Google Ads</div></div><div class=\"ds-inset-note\">授权过的服务，智能体用你的身份调用。</div></div>",
      "css": ".ds-inset { width: 320px; font-family: -apple-system, \"PingFang SC\", sans-serif; } .ds-inset-label { padding: 16px 4px 7px; font-size: 11px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted-foreground, rgba(0, 0, 0, 0.55)); } .ds-inset-group { overflow: hidden; border-radius: 12px; background: var(--card, #f7f5ef); } .ds-inset-row { position: relative; padding: 10px 13px; font-size: 14px; color: var(--foreground, #000000); } .ds-inset-row + .ds-inset-row::before { content: \"\"; position: absolute; top: 0; right: 0; left: 13px; height: 1px; background: var(--border, rgba(0, 0, 0, 0.12)); } .ds-inset-row:hover { background: var(--accent, #dce6f2); } .ds-inset-note { padding: 7px 4px 0; font-size: 11.5px; line-height: 1.5; color: var(--muted-foreground, rgba(0, 0, 0, 0.55)); }"
