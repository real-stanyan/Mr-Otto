      "css": ".ds-input { height: 36px; padding: 4px 12px; border: 1px solid var(--input, rgba(0, 0, 0, 0.12)); border-radius: 6px; background: transparent; color: var(--foreground, #000000); font: 400 14px/1.6 -apple-system, \"PingFang SC\", sans-serif; transition: border-color 150ms cubic-bezier(0.23, 1, 0.32, 1), box-shadow 150ms cubic-bezier(0.23, 1, 0.32, 1); } .ds-input::placeholder { color: var(--muted-foreground, rgba(0, 0, 0, 0.55)); } .ds-input:focus-visible { outline: none; border-color: var(--ring, #4a70a9); box-shadow: 0 0 0 3px color-mix(in srgb, var(--ring, #4a70a9) 50%, transparent); }"
