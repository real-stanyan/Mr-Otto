{
  "expo": {
    "name": "Otto",
    "slug": "mr-otto",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "buildNumber": "9",
      "bundleIdentifier": "com.stanyan.mrotto.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "语音通话、发语音消息时要用麦克风。",
        "NSSpeechRecognitionUsageDescription": "语音通话时把你说的话转成文字，发给智能体。",
        "UIBackgroundModes": [
          "voip",
          "audio"
        ],
        "NSPhotoLibraryUsageDescription": "选照片和视频发到聊天里时要用一下相册。",
        "NSCameraUsageDescription": "拍照片和视频发到聊天里时要用一下相机。",
        "NSHealthShareUsageDescription": "你问智能体健康相关的问题时，读取你的步数、睡眠、心率、体重和体能训练来回答。",
        "NSHealthUpdateUsageDescription": "Otto 只读取健康数据，不会向「健康」写入任何内容。"
      },
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true,
        "com.apple.developer.healthkit": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "mrotto",
    "plugins": [
      "expo-sqlite",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermissionText": "扫描电脑上的配对二维码时要用一下相机。",
          "microphonePermission": "语音通话时要用麦克风听你说话。"
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/ringtone.caf"
          ]
        }
      ],
      "./plugins/withSceneLifecycle",
      [
        "expo-image-picker",
        {
          "photosPermission": "选照片和视频发到聊天里时要用一下相册。",
          "cameraPermission": "拍照片和视频发到聊天里时要用一下相机。",
          "microphonePermission": "拍视频时要录声音。"
        }
      ],
      "expo-video",
      "@config-plugins/react-native-webrtc"
    ],
    "extra": {
      "eas": {
        "projectId": "02a88a0c-a498-4453-b03e-00dac97d5938"
      }
    },
    "owner": "real_stanyan",
    "runtimeVersion": "7",
    "updates": {
      "url": "https://u.expo.dev/02a88a0c-a498-4453-b03e-00dac97d5938",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    }
  }
}
