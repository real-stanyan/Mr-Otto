# otto-edge 的环境变量。真值放服务器上的 .env（chmod 600），永远不进 git。
#
# ADR-0129 之后这个服务只剩落地页 + 远程中继：官方 key 代理与钱包整层删除，
# 所以 SUPABASE_SERVICE_ROLE_KEY / OTTO_UPSTREAM_* / OTTO_GRANT_* 都不再需要。
# 服务器上的旧 .env 里若还留着它们，那是死值——**尤其 service role key，
# 停机时要连同轮换一起处理**（#521）。

# 验客户端 JWT 用。Dashboard → Settings → API → JWT Settings 里的 legacy JWT secret
# （src/jwt.ts 只认 HS256，所以项目的签名 key 必须停在 legacy HS256 那把）
SUPABASE_JWT_SECRET=

PORT=8787
