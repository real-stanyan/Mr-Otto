{
  "$schema": "node_modules/wrangler/config-schema.json",
  // 地址是 <worker名>.<账号子域>.workers.dev,而子域已经是 mrotto ——
  // 叫 mrotto-edge 会得到 mrotto-edge.mrotto.workers.dev,结巴
  "name": "edge",
  "main": "src/worker.ts",
  // Mr Otto 自己的 Cloudflare 账号。**钉死而不是靠 wrangler 当前登录的默认账号**:
  // 一个登录可以是多个账号的成员,不钉的话「部署到哪儿」取决于谁在跑这条命令,
  // 而这个 worker 的地址是要写进客户端编译期常量的 —— 部署错账号 = 一次白发的版本。
  //
  // 为什么不跟别的项目挤同一个账号:workers.dev 的子域名是**账号级**的,
  // 全账号共用一个名字。落地页是用户在 OAuth 流程里看得见的那一屏,
  // 地址栏上顶着另一个项目的名字既不对也不该。
  "account_id": "ab38e454df1503c246069cb89466de63",
  // 自有域名（issue #802）：workers.dev 整域在大陆被 DNS 污染，客户端编译期
  // 常量已换到这个门牌（src/shared/edgeConfig.ts）。workers.dev 地址继续活着
  // 服务存量客户端——同一个 worker 的两个名字，不是两套服务
  "routes": [{ "pattern": "edge.mrotto.agency", "custom_domain": true }],
  // 这个日期定住运行时行为。别顺手往上抬 —— 抬它等于换一批默认值
  "compatibility_date": "2026-04-07",
  "observability": { "enabled": true },
  "durable_objects": {
    // 一户一个实例：getByName(userId)。中继一个 storage API 都不调，
    // 所以下面的 migration 用 new_sqlite_classes（免费版只给 SQLite 后端），
    // 但实际不存任何行 —— 「不落盘」在这里是字面意义的
    "bindings": [
      { "name": "RELAY", "class_name": "Relay" },
      // 托管箱（ADR-0197）：一户一箱，凭据密封在 storage 里，只在 DO 内解封
      { "name": "ESCROW", "class_name": "Escrow" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Relay"] },
    { "tag": "v2", "new_sqlite_classes": ["Escrow"] }
  ],
  // Supabase 项目根（关系闸查 friendships 用）。不是 secret，钉死在配置里
  "vars": { "SUPABASE_URL": "https://kpeemypbhkynapkjzewr.supabase.co" }
  // SUPABASE_JWT_SECRET 是 secret，不写在这里：
  //   npx wrangler secret put SUPABASE_JWT_SECRET
}
