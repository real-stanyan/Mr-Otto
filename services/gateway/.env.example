# otto-gateway 的环境变量。真值放服务器上的 .env（chmod 600），永远不进 git。

# Supabase Cloud（与客户端 src/main/authConfig.ts 同一个项目）
SUPABASE_URL=https://kpeemypbhkynapkjzewr.supabase.co
# 验客户端 JWT 用。Dashboard → Settings → API → JWT Settings 里的 legacy JWT secret
# （src/jwt.ts 只认 HS256，所以项目的签名 key 必须停在 legacy HS256 那把）
SUPABASE_JWT_SECRET=
# 调 rpc 用。绕过 RLS —— 泄漏 = 所有人的钱包失守
SUPABASE_SERVICE_ROLE_KEY=

# 官方 DeepSeek key —— 整个系统里最不能外流的值。只存在这里。
OTTO_UPSTREAM_API_KEY=
OTTO_UPSTREAM_BASE_URL=https://api.deepseek.com/v1

# 新用户注册赠额（token，按桶）。默认见 src/buckets.ts：
# flash 2000 万 + pro 500 万，最坏成本 ≈ $19.35
# OTTO_GRANT_FLASH_TOKENS=20000000
# OTTO_GRANT_PRO_TOKENS=5000000

PORT=8787
