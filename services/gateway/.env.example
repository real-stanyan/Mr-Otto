# otto-gateway 的环境变量。真值放服务器上的 .env（chmod 600），永远不进 git。

# Supabase（与 deploy/otto-auth 那套自建栈同一个实例）
SUPABASE_URL=https://otto-auth.stan.damianslife.com
# 验客户端 JWT 用。就是 supabase docker .env 里的 JWT_SECRET
SUPABASE_JWT_SECRET=
# 调 rpc 用。绕过 RLS —— 泄漏 = 所有人的钱包失守
SUPABASE_SERVICE_ROLE_KEY=

# 官方 DeepSeek key —— 整个系统里最不能外流的值。只存在这里。
OTTO_UPSTREAM_API_KEY=
OTTO_UPSTREAM_BASE_URL=https://api.deepseek.com/v1

# 新用户注册赠额（USD）
OTTO_SIGNUP_GRANT_USD=20

PORT=8787

# 可选：临时覆盖单价（USD per 1M tokens，格式 入价/出价）
# OTTO_PRICE_DEEPSEEK_V4_FLASH=0.28/0.42
