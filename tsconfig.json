{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    // File Layout
    // "rootDir": "./src",
    "outDir": "dist",

    // Environment Settings
    // See also https://aka.ms/tsconfig/module
    "module": "nodenext",
    "target": "es2022",
    "types": ["node"],
    "paths": { "@/*": ["./src/renderer/src/*"] },
    // For nodejs:
    // "lib": ["esnext"],
    // "types": ["node"],
    // and npm install -D @types/node

    // Other Outputs
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Style Options
    // "noImplicitReturns": true,
    // "noImplicitOverride": true,
    // "noUnusedLocals": true,
    // "noUnusedParameters": true,
    // "noFallthroughCasesInSwitch": true,
    // "noPropertyAccessFromIndexSignature": true,

    // Recommended Options
    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
  },

  // mobile/ 是 Expo/RN,有自己的 package.json 与 node_modules。放进来的话,
  // 任何只改桌面的人不先 `npm --prefix mobile install` 就跑不动 `npm test`
  // (而且它那份 @types/node 版本不同,会把根这边的类型也带歪)。
  // **这是临时状态**:三条备选路和各自的代价记在 issue #422(Protocol gap),
  // 收口之前手机端的类型错误进不了门禁。手机端的加密适配层没有这个问题——
  // 它是纯 JS、住在 src/shared/remote/,跟着根门禁跑(ADR-0101)。
  "exclude": [
    "mobile",
    "node_modules",
    "out",
    "dist",
    // Worker 入口带 @cloudflare/workers-types，它重声明 fetch/Request/WebSocket
    // 这些全局，跟这边的 Node 声明打架。它由 services/edge/tsconfig.json 管，
    // npm test 里单跑一条 tsc（同一道门禁，只是两条命令）
    "services/edge/src/worker.ts",
  ],
}
