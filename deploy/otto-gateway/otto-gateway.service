[Unit]
Description=otto-gateway (Mr Otto 官方 key 网关)
Documentation=https://github.com/real-stanyan/Mr-Otto/blob/main/services/gateway/README.md
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=stan
WorkingDirectory=/home/stan/otto-gateway
# .env 里有官方 DeepSeek key 和 service_role key，chmod 600
EnvironmentFile=/home/stan/otto-gateway/.env
ExecStart=/home/stan/otto-gateway/node_modules/.bin/tsx src/server.ts
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
