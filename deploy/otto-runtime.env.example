# deploy/otto-runtime.env.example —— /etc/otto-runtime.env 的字段模板（ADR-0199，task-11）。
# 清单照 services/runtime/src/config.ts 的 REQUIRED_KEYS 抄——真值不进本仓：
# 这份文件只有键名 + 占位符，实际值手动写到远端 /etc/otto-runtime.env
# （systemd unit 的 EnvironmentFile= 指向那里，见 deploy/otto-runtime.service）。
# 缺任何一个必需变量，daemon.ts 的 loadConfig() 会打印缺了哪几个并 exit(1)——
# 不会带着半份配置悄悄跑起来（config.ts 文件头注释）。

# Supabase/relay 服务身份共享密钥（对应 services/edge worker.ts 的 RUNTIME_SECRET）
RUNTIME_SECRET=

# 验 desktop/mobile 发来的登录 JWT（与 Supabase 项目的 JWT secret 一致）
SUPABASE_JWT_SECRET=

# Supabase 项目
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# edge 服务根（好友代理云端执行面），不带尾斜杠
EDGE_BASE=

# relay（cs 帧走的那条 WebSocket 中继），不带尾斜杠
RELAY_BASE=

# 可选：本地状态（EventStore/orphans.json/workspace-config.json）落盘目录。
# 缺省 = /var/lib/otto-runtime（config.ts 的 DEFAULT_DATA_DIR）
#DATA_DIR=/var/lib/otto-runtime

# 模型 key **不在这里**（issue #844，推翻 ADR-0199 决策⑥）：
# 它跟着工作区走，由每个工作区的所有者在客户端里配自己的那把
# （云会话页右上角「配置模型 / 仓库…」）。这台 runtime 不持有任何模型 key，
# 也不做 env 兜底——有兜底就等于"忘了配的工作区默默烧维护者的钱"。
# 没配模型的工作区能建会话、能聊天，但 @Agent 起不了 turn，会回一条看得见的话。
